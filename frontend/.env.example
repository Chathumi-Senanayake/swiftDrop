# "Continue with Google" (Firebase Authentication). Copy this file to .env and fill it in.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# These values are public (they end up in the browser); the server checks every login with Google itself.
# Leave them empty to hide the Google button. The server needs FIREBASE_PROJECT_ID too (see backend/.env.example).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
