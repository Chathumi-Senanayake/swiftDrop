# Port the API listens on
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/swiftdrop

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# "Continue with Google" (Firebase Authentication). Your Firebase project ID, e.g. swiftdrop-12345.
# Leave empty to switch Google sign-in off. The web app also needs frontend/.env (see frontend/.env.example).
FIREBASE_PROJECT_ID=

# How many minutes a customer has to pay after reserving an item
RESERVATION_MINUTES=5

# ---------- Payments ----------
# The address customers open the site at (no trailing slash). Used for the payment gateway's return links.
# Leave empty during development to use whatever address the browser is on.
PUBLIC_URL=

# Cash on delivery (true / false)
COD_ENABLED=true

# Card payments with PayHere (https://www.payhere.lk). Leave the merchant ID empty to switch cards off.
# Sandbox account for testing: https://sandbox.payhere.lk  (Settings -> Domains & Credentials)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = sandbox (test cards, no real money). Set to false for real payments.
PAYHERE_SANDBOX=true
# PayHere's servers call this URL with the payment result, so it must be reachable from the internet
# (e.g. https://swiftdrop.lk/api/payments/payhere/notify, or an ngrok URL while testing on your computer).
# Defaults to PUBLIC_URL + /api/payments/payhere/notify
PAYHERE_NOTIFY_URL=
# Extra minutes items stay reserved while the customer is on the card payment page
CHECKOUT_MINUTES=15
