# Port the API listens on
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/swiftdrop

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# How many minutes a customer has to confirm payment after reserving an item
RESERVATION_MINUTES=5
